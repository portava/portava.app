# ============================================================================
# api-server environment variables — NAMES ONLY, never commit real values.
# Generated from a grep of process.env across artifacts/api-server/src
# (audit Wave 2). Groups: required-at-boot first, then optional features.
# ============================================================================

# ─── REQUIRED AT BOOT (validated by src/lib/envValidation.ts; boot fails) ────
PORT=                              # HTTP listen port
SUPABASE_URL=                      # Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=         # service-role secret (server-only, bypasses RLS)
SESSION_SECRET=                    # random 32+ char secret for sessions

# ─── Optional: observability ─────────────────────────────────────────────────
SENTRY_DSN=                        # enables Sentry error reporting (off when unset)
LOG_LEVEL=                         # pino log level (default: info)

# ─── Optional: internal / admin secrets ──────────────────────────────────────
INTERNAL_API_SECRET=               # X-Internal-Secret for /internal/* endpoints (incl. deletion worker); endpoints disabled when unset
CLEANUP_ADMIN_SECRET=              # shared secret for cleanup endpoints
INTERNAL_ADMIN_TOKEN=              # internal admin token (scripts)
COMPASS_TOKEN_SECRET=              # Compass share-token signing secret
INTERNAL_API_BASE=                 # base URL used for internal self-calls

# ─── Optional: CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=                   # comma-separated browser origins; hardcoded fallback + warning when unset

# ─── Optional: Redis ─────────────────────────────────────────────────────────
REDIS_URL=                         # shared rate limiting (lib/rateLimit.ts, routes/crashReport.ts); in-memory fallback when unset

# ─── Optional: LiveKit (in-app calls) ────────────────────────────────────────
LIVEKIT_URL=                       # wss://<livekit-host>
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Optional: Maps / places / events providers ──────────────────────────────
FOURSQUARE_API_KEY=                # Foursquare places — legacy shared key, used when
                                    # FSQ_API_KEY_DEV / FSQ_API_KEY_PROD (below) are unset
FSQ_API_KEY_DEV=                   # Foursquare places — dev-only key (lib/foursquareApiKey.ts).
                                    # Isolates dev testing quota from production quota; falls
                                    # back to FOURSQUARE_API_KEY when unset.
FSQ_API_KEY_PROD=                  # Foursquare places — prod-only key. Same fallback rule.
                                    # Provision this in the production deployment's secrets,
                                    # not here.
GOOGLE_MAPS_API_KEY=               # Google geocoding / places. NOTE: GOOGLE_PLACES_API_KEY
                                    # is NOT read anywhere in this codebase — do not set it
                                    # expecting it to affect Places behaviour.
MAPBOX_TOKEN=                      # Mapbox geocoding (server)
TICKETMASTER_API_KEY=              # Ticketmaster events ingest

# ─── Optional: Supabase extras (scripts / CI / seeds) ────────────────────────
SUPABASE_ANON_KEY=                 # anon key (some scripts)
SUPABASE_ACCESS_TOKEN=             # management token (CI/scripts)
SUPABASE_PROJECT_TOKEN=            # management token (CI/scripts)
EXPO_PUBLIC_SUPABASE_URL=          # read by some shared/test code paths
EXPO_PUBLIC_SUPABASE_ANON_KEY=     # read by some shared/test code paths

# ─── Optional: OpenAI / AI visuals ───────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=    # OpenAI key (stamps, Compass intelligence)
AI_INTEGRATIONS_OPENAI_BASE_URL=   # OpenAI-compatible proxy base URL
AI_IMAGE_MODEL=                    # image model for AI visuals
AI_IMAGE_QUALITY=                  # image quality setting
AI_IMAGE_COST_ESTIMATE=            # per-image cost estimate (budget accounting)
AI_VISUAL_WORKER_INTERVAL_MS=      # visuals worker poll interval
AI_VISUAL_DAILY_LIMIT=             # global daily generation cap
AI_VISUAL_USER_DAILY_LIMIT=        # per-user daily generation cap
AI_VISUAL_COST_PER_IMAGE=          # cost per generated image
AI_VISUAL_BUCKET=                  # storage bucket for generated visuals
AI_VISUAL_FALLBACK_BASE=           # base URL for category fallback images
AI_VISUAL_MAX_RETRIES=             # generation retry cap

# ─── Optional: stamp artwork worker ──────────────────────────────────────────
# CAUTION: dev and prod share one Supabase DB — jobs enqueued from dev run on
# whichever worker is enabled.
STAMP_WORKER_ENABLED=              # worker only runs when "true"
STAMP_IMAGE_MODEL=                 # e.g. gpt-image-1 (dall-e-3 deprecated/rejected)
STAMP_IMAGE_QUALITY=
STAMP_WORKER_INTERVAL_MS=
STAMP_MIN_CANDIDATES=
STAMP_FAILED_REQUEUE_HOURS=
STAMP_FAILED_REQUEUE_MAX_ROUNDS=
STAMP_STALE_SWEEP_INTERVAL_MINUTES=
STAMP_COUNTRY_SWEEP_ENABLED=

# ─── Optional: FX daily refresh (budget currency conversion) ─────────────────
FX_REFRESH_ENABLED=                # "true" pulls ECB rates into fx_rates daily
FX_REFRESH_INTERVAL_MS=            # default 24h
FX_REFRESH_URL=                    # default https://api.frankfurter.dev/v1/latest?base=EUR

# ─── Optional: identity verification (KYC) ───────────────────────────────────
IDENTITY_PROVIDER=                 # e.g. mock (see PROVISIONING.md PROV-02)
ALLOW_REMOTE_VERIFY=               # allow remote verification flows

# ─── Optional: rate-limit tuning ─────────────────────────────────────────────
REPORT_RATE_LIMIT_PER_HOUR=        # default 10
MUTE_RATE_LIMIT_PER_DAY=           # default 50
MODERATION_REPORT_RATE_LIMIT_PER_DAY=  # default 10
CIRCLE_MEMBERS_RL_LIMIT=
CIRCLE_PRESENCE_RL_LIMIT=
CIRCLE_NEED_HELP_RL_LIMIT=
CRASH_REPORT_WINDOW_MS=            # default 60000
CRASH_REPORT_MAX_REPORTS=          # default 10

# ─── Optional: background sweepers / schedulers ──────────────────────────────
EVENT_WAITLIST_SWEEP_INTERVAL_HOURS=
EVENT_WAITLIST_SWEEP_STARTUP_DELAY_MS=
INVITE_SLOT_RECONCILE_INTERVAL_HOURS=
INVITE_SLOT_RECONCILE_MIN_AGE_MINUTES=
INVITE_SLOT_SWEEP_INTERVAL_HOURS=
INVITE_SLOT_SWEEP_TTL_HOURS=
ZOMBIE_TOKEN_SWEEP_INTERVAL_HOURS=
ZOMBIE_TOKEN_SWEEP_LOOKBACK_DAYS=
ZOMBIE_TOKEN_SWEEP_FAILURE_THRESHOLD=
DAILY_BRIEF_RETENTION_DAYS=
DAILY_BRIEF_CLEANUP_INTERVAL_HOURS=
DELAYED_POST_PUBLISH_INTERVAL_MINUTES=
WEATHER_CACHE_RETENTION_HOURS=
SUGGESTION_SEEN_TTL_HOURS=
SUGGESTION_SEEN_MAX=
PLACE_COLLECTIONS_WORKER_ENABLED=
GEOFENCE_CONFIRMATION_MINUTES=
OFF_APP_SUSPENSION_THRESHOLD=

# ─── Optional: translation ───────────────────────────────────────────────────
TRANSLATION_ENABLED=
TRANSLATION_PROVIDER=              # e.g. openai
TRANSLATION_TIMEOUT_MS=

# ─── Optional: misc / environment plumbing ───────────────────────────────────
NODE_ENV=                          # production enables error-detail suppression
APP_ENV=
API_BASE_URL=                      # public base URL of this API (also used by cron examples)
API_BASE=                          # legacy alias used by some scripts
APP_RETURN_BASE_URL=               # deep-link return base for verification flows

# ── Mobile deep-link / app-association credentials (from EAS, not the repo) ──
# Consumed by routes/wellKnownShare.ts, which serves
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# (plus the /u/:username and /passport/:username share pages) directly from
# this API server. Both endpoints return 503 until their var is set.
APPLE_APP_ID_PREFIX=               # Apple Team ID, e.g. A1B2C3D4E5 (prefixed onto the bundle id)
ANDROID_CERT_SHA256=               # Android signing cert SHA-256 fingerprint(s), colon-separated hex;
                                   # comma-separate multiple certs (Play App Signing issues its own)
GENERIC_COVER_URL=                 # override for generic cover placeholder
PORTAVA_ACCOUNT_UUID=              # @portava official account id (seeder/publisher)
PORTAVA_ACCOUNT_EMAIL=             # @portava official account email
ALLOW_TEST_MEDIA_SEED=             # test-media seed guard
SEED_DRY_RUN=                      # seed scripts dry-run flag
SEED_EMAIL=                        # seed scripts target email
REPLIT_DEV_DOMAIN=                 # set automatically by Replit workspace (dev only)
HOSTNAME=                          # set by platform; used in scheduler lock ids
FONTCONFIG_PATH=                   # set by platform for sharp/canvas font rendering

# ── Feature flags live in the feature_flags DB table, NOT here ───────────────
# Stamp:  stamp_premium_rendering_enabled, stamp_showcase_enabled,
#         stamp_admire_enabled, stamp_criteria_engine_enabled,
#         stamp_unified_view_enabled
# Data:   country_essentials_enabled, budget_fx_conversion_enabled,
#         fsq_places_enabled
# See PORTAVA-ACTIVATION-GUIDE.md for what each turns on and safe order.
