# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
SUPABASE_ANON_KEY=<anon-key>

# ─── Auth / Sessions ─────────────────────────────────────────────────────────
# REQUIRED in production. Also used to sign internal tokens.
SESSION_SECRET=<random-32-char-secret>

# ─── Error reporting ─────────────────────────────────────────────────────────
# Server-side Sentry DSN. When unset, Sentry is disabled and the server logs
# "[sentry] SENTRY_DSN not set" on boot (see src/lib/sentry.ts).
SENTRY_DSN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.  Must be set in production
# to prevent a warning on every cold start.  Mobile apps (no Origin header) are
# always allowed through regardless of this setting.
ALLOWED_ORIGINS=https://app.travel-buddy.io,https://www.travel-buddy.io,https://portava.replit.app

# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://<livekit-host>
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>

# ─── Maps / Geocoding ────────────────────────────────────────────────────────
FOURSQUARE_API_KEY=<key>

# ─── Admin helpers ───────────────────────────────────────────────────────────
# CLEANUP_ADMIN_SECRET=<shared-secret-for-cleanup-endpoints>

# ── Stamp artwork generation (docs added 2026-07-23) ─────────────────────────
# Worker only runs when true. CAUTION: dev and prod share one Supabase DB —
# jobs enqueued from dev run on whichever worker is enabled.
STAMP_WORKER_ENABLED=false
# Image model must be supported by your AI proxy (dall-e-3 is deprecated/rejected).
STAMP_IMAGE_MODEL=gpt-image-1
STAMP_IMAGE_QUALITY=high
# Optional tuning: STAMP_WORKER_INTERVAL_MS, STAMP_MIN_CANDIDATES,
# STAMP_FAILED_REQUEUE_HOURS, STAMP_FAILED_REQUEUE_MAX_ROUNDS,
# STAMP_STALE_SWEEP_INTERVAL_MINUTES, STAMP_COUNTRY_SWEEP_ENABLED

# ── FX daily refresh (budget currency conversion) ─────────────────────────────
# When true, pulls ECB reference rates (frankfurter.dev) into fx_rates once a
# day so budget conversions stay current. Off = rates stay at whatever was last
# loaded (conversion still works, just not auto-updated).
FX_REFRESH_ENABLED=false
# Optional: FX_REFRESH_INTERVAL_MS (default 24h), FX_REFRESH_URL (default
# https://api.frankfurter.dev/v1/latest?base=EUR)

# ── Feature flags (set in the feature_flags DB table, NOT here) ───────────────
# Stamp:  stamp_premium_rendering_enabled, stamp_showcase_enabled,
#         stamp_admire_enabled, stamp_criteria_engine_enabled,
#         stamp_unified_view_enabled
# Data:   country_essentials_enabled, budget_fx_conversion_enabled,
#         fsq_places_enabled
# See PORTAVA-ACTIVATION-GUIDE.md for what each turns on and safe order.

# ── Added by audit close-out (PROV-04): external creds/config read by the code ──
# OpenAI (stamp image generation / Compass intelligence)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Ticketmaster events ingest
TICKETMASTER_API_KEY=
# Mapbox geocoding token (server)
MAPBOX_TOKEN=
# Redis (rate limiting / cache) — optional
REDIS_URL=
# Internal secrets
COMPASS_TOKEN_SECRET=
# REQUIRED: POST /internal/buddy-requests/expire fails closed (503) without it.
# It no longer falls back to SESSION_SECRET — set it explicitly or the
# buddy-request expiry job cannot run.
INTERNAL_API_SECRET=
CLEANUP_ADMIN_SECRET=

# ── Universal / App Link association files (served by the web-origin server) ──
# travel-buddy-standalone/server/serve.js serves
#   /.well-known/apple-app-site-association  and  /.well-known/assetlinks.json
# from the EXPO_PUBLIC_WEB_ORIGIN host. Both return 503 until these are set —
# deliberately, since a wrong value makes Apple/Google cache a FAILED
# verification. Both come from the EAS credential store, not the repo.
#
# Apple Developer Team ID, e.g. A1B2C3D4E5 (prefixed onto the bundle id).
APPLE_APP_ID_PREFIX=
# Android signing cert SHA-256 fingerprint(s), colon-separated hex.
# Comma-separate multiple certs (Play App Signing issues its own).
ANDROID_CERT_SHA256=
# Supabase management tokens (CI/scripts)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_TOKEN=
# Calling (LiveKit) — see PROVISIONING.md PROV-03
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Identity/KYC — see PROVISIONING.md PROV-02
IDENTITY_PROVIDER=mock
