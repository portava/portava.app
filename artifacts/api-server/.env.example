# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
SUPABASE_ANON_KEY=<anon-key>

# ─── Auth / Sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=<random-32-char-secret>

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Omit to use the built-in defaults.  Mobile apps (no Origin header) are always
# allowed through regardless of this setting.
# ALLOWED_ORIGINS=https://app.travel-buddy.io,https://www.travel-buddy.io

# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://<livekit-host>
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>

# ─── Maps / Geocoding ────────────────────────────────────────────────────────
MAPTILER_API_KEY=<key>
GOOGLE_MAPS_API_KEY=<key>
FOURSQUARE_API_KEY=<key>

# ─── Admin helpers ───────────────────────────────────────────────────────────
# CLEANUP_ADMIN_SECRET=<shared-secret-for-cleanup-endpoints>
