{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "routes:guard": "tsx ./src/guard-expo-router-duplicates.ts",
    "routes:self-heal": "SELF_HEAL_EXPO_ROUTES=1 tsx ./src/guard-expo-router-duplicates.ts",
    "test:routes-guard": "node --import tsx/esm --test ./src/guard-expo-router-duplicates.test.ts",
    "test:workflow-paths": "node --import tsx/esm --test ./src/workflow-paths.test.ts",
    "test:db-triggers": "node --import tsx/esm --test ./src/check-db-triggers.test.ts",
    "test:engagement-indexes": "node --import tsx/esm --test ./src/check-engagement-indexes.test.ts",
    "test:truncate-guard": "node --import tsx/esm --test ./src/saved-places-truncate-guard.test.ts",
    "test:fixture-guard": "node --import tsx/esm --test ./src/fixture-import-guard.test.ts",
    "test:dead-routes": "node --import tsx/esm --test ./src/dead-routes-guard.test.ts",
    "seed:profiles": "tsx ./src/seed-test-profiles.ts",
    "backfill:stamps": "tsx ./src/backfill-stamps.ts",
    "backfill:stamps:apply": "tsx ./src/backfill-stamps.ts --apply",
    "refresh:live-columns": "tsx ./src/refresh-live-columns.ts",
    "check:rent-buddy-contract": "tsx ./src/rentBuddyContractCheck.ts",
    "test:cross-tree-paths": "node --import tsx/esm --test ./src/cross-tree-paths.test.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@types/node": "catalog:",
    "dotenv": "^16.4.7",
    "tsx": "catalog:",
    "typescript": "5.9.3"
  }
}
