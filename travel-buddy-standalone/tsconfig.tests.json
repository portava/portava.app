{
  // Typechecks the test files that tsconfig.json deliberately excludes.
  //
  // It exists for scripts/check-test-fixture-shapes.mjs, which reports ONLY
  // object-literal shape mismatches from this program's diagnostics. Running
  // `tsc -p tsconfig.tests.json` by hand will show many OTHER errors — implicit
  // anys, matcher signatures, RN prop variance. Those are real debt but are not
  // what this config is wired to gate on; see the guard script's header.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "scripts/types/test-globals.d.ts"
  ],
  "exclude": ["__mocks__/**", "node_modules/**"]
}
