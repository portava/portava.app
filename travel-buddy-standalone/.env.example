# ─────────────────────────────────────────────────────────────────────────────
# Portava mobile app (Expo) — client environment
#
# Everything here is EXPO_PUBLIC_*, which means it is BAKED INTO THE BUNDLE and
# readable by anyone with the app. Never put a service-role key, a signing
# secret, or any server credential in this file.
#
# For EAS builds these come from the `env` blocks in eas.json (preview +
# production) and/or the EAS project environment — not from this file. This
# file is for local `expo start` runs and as the checklist of what must exist.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (required) ─────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# ─── Backend + web origin (required for release builds) ──────────────────────
# API server base URL. eas.json sets this for the preview + production profiles.
EXPO_PUBLIC_API_BASE_URL=https://portava.replit.app
# Origin used for share links, universal links and the expo-router origin.
# Must match app.json (ios.associatedDomains, android.intentFilters) and be the
# host serving /.well-known/apple-app-site-association + /assetlinks.json.
EXPO_PUBLIC_WEB_ORIGIN=https://portava.replit.app

# ─── Error reporting ─────────────────────────────────────────────────────────
# Client Sentry DSN. Provision in the EAS project environment.
# NOTE: SENTRY_AUTH_TOKEN (sourcemap upload, used by the eas-build-on-success
# script) is a SECRET — set it in EAS, never here and never as EXPO_PUBLIC_*.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Maps ────────────────────────────────────────────────────────────────────
# MapTiler API key — required for native MapLibre maps (iOS/Android).
# TODO (owner): Create a free account at https://www.maptiler.com/, create an
# API key, and set the real value here and in your EAS environment.
EXPO_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE

# ─── Places ──────────────────────────────────────────────────────────────────
# REMOVED 2026-08-15: EXPO_PUBLIC_FOURSQUARE_API_KEY.
#
# The client no longer calls Foursquare. It calls the api-server's
# GET /api/places/fsq-photo, which holds FOURSQUARE_API_KEY server-side.
#
# The direct call could not work on web anyway — places-api.foursquare.com
# serves no browser CORS headers — and EXPO_PUBLIC_* compiles into the client
# bundle, so the key shipped to every browser that loaded the app.
#
# If that key was ever populated here and shipped, treat it as COMPROMISED and
# ROTATE IT. Removing the call site stops the bleeding; it does not un-ship a
# credential that is already in users' bundles.
