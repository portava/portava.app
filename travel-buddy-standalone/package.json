{
  "name": "travel-buddy-standalone",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/android-dev.sh",
    "dev:android": "bash scripts/android-dev.sh --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "corepack enable && bash scripts/eas-install-rust.sh",
    "eas-build-on-success": "bash scripts/eas-upload-sourcemaps.sh",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/check-import-extensions.mjs",
    "check:route-registry": "node scripts/check-route-registry.mjs",
    "test": "node scripts/run-node-tests.mjs",
    "test:event-rab-cta": "node --import tsx/esm --test src/services/__tests__/event.rabCta.test.ts",
    "test:stamps": "node --import tsx --test src/test/stampGracefulDegradation.test.ts",
    "test:invite-gone": "node --import tsx/esm --test src/lib/__tests__/inviteCardGoneHandler.test.ts",
    "test:component": "node scripts/check-test-mocks.mjs && jest --forceExit --testPathPattern='\\.component\\.test\\.' && jest -c jest.web.config.js --forceExit",
    "lint:imports": "node scripts/check-import-extensions.mjs",
    "lint:bare-image": "node scripts/check-bare-image.mjs",
    "lint:avatar-icon-sizing": "node scripts/check-avatar-icon-sizing.mjs",
    "test:avatar-icon-sizing-guard": "node scripts/check-avatar-icon-sizing.test.mjs",
    "lint:ksv": "node scripts/check-ksv-inner-scroll.mjs",
    "lint:mocks": "node scripts/check-test-mocks.mjs",
    "lint:orphan-tests": "node scripts/check-orphan-tests.mjs",
    "check:test-fixture-shapes": "node scripts/check-test-fixture-shapes.mjs",
    "lint:close-then-navigate": "node scripts/check-close-then-navigate.mjs",
    "lint:dev-proxy-not-shipped": "node scripts/check-dev-proxy-not-shipped.mjs",
    "check:all": "bash scripts/run-all-checks.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@maplibre/maplibre-react-native": "11.3.6",
    "@op-engineering/op-sqlite": "^17.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@sentry/react-native": "^8.20.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "@ungap/structured-clone": "^1.3.2",
    "expo": "~54.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.11",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.4",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-openmls": "file:./vendor/expo-openmls",
    "expo-router": "~6.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.10",
    "livekit-client": "^2.20.1",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "54.0.23",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.20.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "react-test-renderer": "19.1.0",
    "tsx": "4.22.4",
    "typescript": "~5.9.2"
  }
}
