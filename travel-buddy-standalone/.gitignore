# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# These are bare patterns: they match a directory named ios/ or android/ at ANY
# depth, not just the prebuild output at the app root. That silently swallowed
# the whole native surface of the vendored OpenMLS module — build.gradle, the
# Kotlin module, the podspec and the Swift module were never committed, so EAS
# built and shipped an APK with no E2EE code in it at all. Re-include them
# below; they are hand-written source, not prebuild output.
ios/
android/
!vendor/expo-openmls/ios/
!vendor/expo-openmls/android/
!modules/portava-video-compressor/ios/
!modules/portava-video-compressor/android/
!modules/portava-background-upload/android/
!modules/portava-on-device-speech/ios/
!modules/portava-on-device-speech/android/
!modules/portava-nearby-checkpoint/ios/
!modules/portava-nearby-checkpoint/android/
modules/portava-on-device-speech/android/build/
modules/portava-on-device-speech/android/.gradle/
modules/portava-on-device-speech/android/.cxx/
modules/portava-nearby-checkpoint/android/build/
modules/portava-nearby-checkpoint/android/.gradle/
modules/portava-nearby-checkpoint/android/.cxx/
modules/portava-background-upload/android/build/
modules/portava-background-upload/android/.gradle/
modules/portava-video-compressor/android/build/
modules/portava-video-compressor/android/.gradle/
modules/portava-video-compressor/android/.cxx/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Production build output (scripts/build.js), 35 MB and regenerated by every
# deploy. It was never tracked but was never ignored either, so running the
# documented production build left it staged by any `git add -A`.
static-build/
