require 'json'

package = JSON.parse(File.read(File.join(__dir__, '..', 'package.json')))

# ── Generate the Rust staticlib and the UniFFI Swift bindings ────────────────
#
# THE BUG THIS FIXES (2026-08-29)
#
# ExpoOpenmlsModule.swift calls eight free functions (generateIdentityKeyPair,
# generateDeviceKeyPair, generateKeyPackage, createGroup, processWelcome,
# encryptMessage, decryptMessage, deriveSafetyNumber). None are hand-written:
# they exist only in Rust/uniffi/openmls/openmls.swift, generated by UniFFI from
# src/openmls.udl. Rust/ is in this module's .gitignore, and nothing generated
# it. A fresh checkout therefore compiled the module with the bindings missing:
#
#   ExpoOpenmlsModule.swift:17: cannot find 'generateIdentityKeyPair' in scope
#   ...and the same for all eight.
#
# Builds only ever succeeded on a machine where someone had produced Rust/ by
# hand. This runs at PODSPEC EVALUATION time — i.e. during `pod install`, before
# CocoaPods globs source_files below — because a `script_phase` would be too
# late: CocoaPods decides which files are in the target at install time, so
# generating during the build leaves the target empty and the error unchanged.
# `prepare_command` is not used either: it does not run for `:path` pods, which
# is exactly how Expo autolinking installs this module.
#
# The script is idempotent and exits immediately when the outputs are newer than
# the sources, so a normal `pod install` pays nothing.
build_script = File.join(__dir__, '..', 'scripts', 'build-ios.sh')
if File.exist?(build_script)
  Pod::UI.puts '[ExpoOpenmls] generating Rust staticlib + UniFFI Swift bindings…'
  unless system('bash', build_script)
    raise <<~MSG
      [ExpoOpenmls] scripts/build-ios.sh failed.

      Without it there are no UniFFI Swift bindings, and ExpoOpenmlsModule.swift
      cannot compile ("cannot find 'generateIdentityKeyPair' in scope" x8).

      Most likely causes:
        - cargo missing            -> travel-buddy-standalone/scripts/eas-install-rust.sh
        - iOS targets missing      -> rustup target add aarch64-apple-ios aarch64-apple-ios-sim
        - DEVELOPER_DIR points at CommandLineTools rather than Xcode, so clang
          links the macOS SDK into an iOS target and ld fails with
          "building for 'iOS-simulator', but linking in dylib built for 'macOS'"
    MSG
  end
else
  raise "[ExpoOpenmls] scripts/build-ios.sh is missing from the module — it must ship inside the package."
end

Pod::Spec.new do |s|
  s.name           = 'ExpoOpenmls'
  s.version        = package['version']
  s.summary        = package['description']
  s.author         = 'Portava'
  s.homepage       = 'https://portava.com'
  s.license        = 'MIT'
  s.platforms      = { ios: '15.0' }

  # Source: the directory containing this podspec
  s.source         = { path: '.' }

  # Expo modules core dependency (provides Module, ModuleDefinition, etc.)
  s.dependency 'ExpoModulesCore'

  # The hand-written Expo wrapper plus the UniFFI-generated bindings. The
  # generated half is produced by the script above; if that glob is ever empty
  # again, the eight "cannot find … in scope" errors come straight back.
  s.source_files   = [
    'ExpoOpenmls/**/*.{h,m,swift}',
    'Rust/uniffi/openmls/*.swift',
  ]

  # The Rust staticlib is selected per platform rather than declared with
  # `vendored_libraries`. Device and Apple-silicon simulator are BOTH arm64, so
  # one fat archive cannot hold both slices — scripts/build-ios.sh writes
  # Rust/iphoneos/ and Rust/iphonesimulator/, and $(PLATFORM_NAME) picks one.
  s.pod_target_xcconfig = {
    'SWIFT_VERSION'        => '5.9',

    # openmls.swift does `import openmlsFFI`, which resolves only through the
    # generated modulemap. Without all three of these the bindings compile to
    # nothing usable — this was the second half of the original breakage.
    'HEADER_SEARCH_PATHS'  => '"$(PODS_TARGET_SRCROOT)/Rust/uniffi/openmls" "${PODS_ROOT}/Headers/Public/ExpoModulesCore"',
    'SWIFT_INCLUDE_PATHS'  => '"$(PODS_TARGET_SRCROOT)/Rust/uniffi/openmls"',
    'OTHER_SWIFT_FLAGS'    => '-Xcc -fmodule-map-file="$(PODS_TARGET_SRCROOT)/Rust/uniffi/openmls/openmlsFFI.modulemap"',

    'LIBRARY_SEARCH_PATHS' => '"$(PODS_TARGET_SRCROOT)/Rust/$(PLATFORM_NAME)"',
    'OTHER_LDFLAGS'        => '-lc++ -lexpo_openmls',
  }

  s.preserve_paths = ['Rust/**/*']
end
