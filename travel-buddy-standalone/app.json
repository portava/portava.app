{
  "expo": {
    "name": "Travel Buddy",
    "slug": "travel-buddy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelbuddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": true
      },
      "bundleIdentifier": "com.passporttravelbuddy.app",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:portava.replit.app"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "travelbuddy"
        ],
        "NSCalendarsUsageDescription": "Portava adds confirmed meetups to your calendar so you never miss a plan.",
        "NSLocationWhenInUseUsageDescription": "Portava uses your location to show nearby places and auto-publish posts after you leave a spot.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Portava uses your location in the background to track route progress, trigger check-ins, and automatically publish your post after you leave a spot.",
        "NSCameraUsageDescription": "Portava uses your camera for video calls and so you can add photos to posts and your passport.",
        "NSPhotoLibraryUsageDescription": "Portava accesses your photo library so you can upload trip photos and profile pictures.",
        "NSMicrophoneUsageDescription": "Portava uses your microphone for voice and video calls with your travel contacts, and for video content attached to posts."
      }
    },
    "android": {
      "package": "com.passporttravelbuddy.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1D33"
      },
      "notificationChannels": [
        {
          "name": "incoming_calls",
          "importance": "max",
          "sound": true,
          "vibrate": true,
          "enableLights": true
        }
      ],
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "travelbuddy"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "portava.replit.app",
              "pathPrefix": "/passport"
            },
            {
              "scheme": "https",
              "host": "portava.replit.app",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://portava.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Portava uses your location in the background to track route progress, trigger check-ins, and automatically publish your post after you leave a spot.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-dev-client",
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      "@livekit/react-native-expo-plugin",
      "./plugins/withPortavaNSE",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b4147876-b8f9-4ea2-94f4-dd9f4e9cb65b"
      }
    },
    "owner": "travel-buddy1"
  }
}
