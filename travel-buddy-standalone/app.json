      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "travelbuddy"
        ],
        "NSCalendarsUsageDescription": "Travel Buddy adds confirmed meetups to your calendar so you never miss a plan.",
        "NSLocationWhenInUseUsageDescription": "Travel Buddy uses your location to show nearby places and auto-publish posts after you leave a spot.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Travel Buddy uses your location in the background to track route progress and trigger check-ins.",
        "NSCameraUsageDescription": "Travel Buddy uses your camera so you can add photos to posts and your passport.",
        "NSPhotoLibraryUsageDescription": "Travel Buddy accesses your photo library so you can upload trip photos and profile pictures.",
