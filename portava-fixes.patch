+[package]
+name = "expo-openmls"
+version = "0.1.0"
+edition = "2021"
+
+# UniFFI scaffolding: generates Swift/Kotlin bindings from openmls.udl
+[lib]
+crate-type = ["staticlib", "cdylib"]
+
+[dependencies]
+# MLS RFC 9420 implementation
+openmls = { version = "0.5.0", features = ["crypto-subtle"] }
+openmls_rust_crypto = "0.2.0"
+openmls_basic_credential = "0.2.0"
+
+# UniFFI — generates Swift/Kotlin bindings from the UDL
+uniffi = { version = "0.28.3", features = ["scaffolding"] }
+
+# Independent Ed25519 + X25519 for identity/device key generation
+ed25519-dalek = { version = "2.1.1", features = ["rand_core"] }
+x25519-dalek   = { version = "2.0.1", features = ["static_secrets"] }
+
+# SHA-512 for safety-number derivation
+sha2 = "0.10.8"
+
+# Base64 for byte ↔ string boundary crossing
+base64 = "0.22.1"
+
+# JSON serialisation for group state bundles
+serde       = { version = "1.0", features = ["derive"] }
+serde_json  = "1.0"
+
+# Random-number generation
+rand = "0.8"
+
+[build-dependencies]
+uniffi = { version = "0.28.3", features = ["build"] }
