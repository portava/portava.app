# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
SUPABASE_ANON_KEY=<anon-key>

# ─── Auth / Sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=<random-32-char-secret>

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Omit to use the built-in defaults.  Mobile apps (no Origin header) are always
# allowed through regardless of this setting.
# ALLOWED_ORIGINS=https://app.travel-buddy.io,https://www.travel-buddy.io

# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://<livekit-host>
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>

# ─── Maps / Geocoding ────────────────────────────────────────────────────────
MAPTILER_API_KEY=<key>
GOOGLE_MAPS_API_KEY=<key>
FOURSQUARE_API_KEY=<key>

# ─── Admin helpers ───────────────────────────────────────────────────────────
# CLEANUP_ADMIN_SECRET=<shared-secret-for-cleanup-endpoints>

# ── Stamp artwork generation (docs added 2026-07-23) ─────────────────────────
# Worker only runs when true. CAUTION: dev and prod share one Supabase DB —
# jobs enqueued from dev run on whichever worker is enabled.
STAMP_WORKER_ENABLED=false
# Image model must be supported by your AI proxy (dall-e-3 is deprecated/rejected).
STAMP_IMAGE_MODEL=gpt-image-1
STAMP_IMAGE_QUALITY=high
# Optional tuning: STAMP_WORKER_INTERVAL_MS, STAMP_MIN_CANDIDATES,
# STAMP_FAILED_REQUEUE_HOURS, STAMP_FAILED_REQUEUE_MAX_ROUNDS,
# STAMP_STALE_SWEEP_INTERVAL_MINUTES, STAMP_COUNTRY_SWEEP_ENABLED

# ── FX daily refresh (budget currency conversion) ─────────────────────────────
# When true, pulls ECB reference rates (frankfurter.dev) into fx_rates once a
# day so budget conversions stay current. Off = rates stay at whatever was last
# loaded (conversion still works, just not auto-updated).
FX_REFRESH_ENABLED=false
# Optional: FX_REFRESH_INTERVAL_MS (default 24h), FX_REFRESH_URL (default
# https://api.frankfurter.dev/v1/latest?base=EUR)

# ── Feature flags (set in the feature_flags DB table, NOT here) ───────────────
# Stamp:  stamp_premium_rendering_enabled, stamp_showcase_enabled,
#         stamp_admire_enabled, stamp_criteria_engine_enabled,
#         stamp_unified_view_enabled
# Data:   country_essentials_enabled, budget_fx_conversion_enabled,
#         fsq_places_enabled
# See PORTAVA-ACTIVATION-GUIDE.md for what each turns on and safe order.
