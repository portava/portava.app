# Dependencies
# The trailing slash matches DIRECTORIES ONLY. A worktree that symlinks
# node_modules to another checkout's copy — the documented way to skip a second
# pnpm install — produces a SYMLINK, which these two patterns do not match, so
# `git add -A` happily commits it and CI's `pnpm install` then dies on
# "ENOENT ... mkdir '<repo>/artifacts/api-server/node_modules'". The slashless
# pattern below covers that case.
node_modules/
**/node_modules/
node_modules
**/node_modules
.pnpm-store/

# Build outputs
.expo/
ios/build/
android/build/
android/app/build/
*.apk
*.aab
*.ipa
dist/
build/
web-build/

# Native
android/.gradle/
android/local.properties
android/.idea/
ios/Pods/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# Logs / caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Backup files from tonight's troubleshooting
*.bak
app.json.bak

# Editor
.vscode/
.idea/
*.swp

# TypeScript build cache
*.tsbuildinfo
.env.missing.runtime

.local/
.cache/
.npm/
.pnpm-store/
*.tar.gz
*.zip
screenshots/
attached_assets/

# Recovery snapshots — contain real user data, never commit
.recovery/
recovery-backups/

# Checkpoint written by artifacts/api-server backfill:feed-variants (--state).
# Run-local progress, never shared state — committing it would make another
# machine skip rows it has not actually processed.
.backfill-feed-variants.json

# Drop scaffolding — apply scripts stage backups here; Replit publish commits the whole tree
.ci-backup/
.drop2-backup/
_ci/
_drop2/
*.pre-fix
apply-*.sh
fix-*.sh
*-drop.zip
drop*.zip
ci-drop.zip
_incoming/

# artifacts/travel-buddy was ARCHIVED on 2026-08-14 (tree at bc1bef404).
# Expo/EAS tooling in the workspace still recreates a handful of files under
# that path — expo-env.d.ts, .expo/, .tsbuildinfo, an ios/ scaffold, node_modules
# and .env files. Most were already covered by the individual rules above, but
# two (expo-env.d.ts and ios/PortavaNSE/NotificationService.swift) were not, and
# this workspace auto-commits: they would have been swept back into git under a
# path the archival deliberately removed, partially resurrecting the tree in the
# record without anyone deciding to.
# Ignoring the path outright. If the tree is ever genuinely restored, delete
# this rule in the same change that restores it.
/artifacts/travel-buddy/

# Claude Code config + credentials (persisted here because ~ is ephemeral on Replit)
.claude-home/
