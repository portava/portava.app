modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "routes-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-standalone"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "sync-standalone-check"

[[workflows.workflow]]
name = "routes-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:routes-guard"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-standalone"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd travel-buddy-standalone && pnpm typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "sync-standalone-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/sync-standalone.sh --dry-run"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082

[[ports]]
localPort = 20682
externalPort = 3000

[[ports]]
localPort = 20683
externalPort = 3003

[nix]
channel = "stable-25_05"
packages = ["zip"]

[userenv]

[userenv.shared]
SUPABASE_URL = "https://ajrurzioarfkagpuxfnb.supabase.co"
