modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
# Build/run for the API server (artifacts/api-server) — added by audit Wave 2.
# Mirrors that package's scripts: "build" runs the Sentry/OTel dep check then
# esbuild (build.mjs → dist/), "start" boots dist/index.mjs with the Sentry
# preload. Best-effort: deployment settings configured in the Replit UI
# override this file, so CONFIRM these commands in the Replit Deployments UI
# before relying on them.
build = ["pnpm", "--filter", "@workspace/api-server", "run", "build"]
run = ["pnpm", "--filter", "@workspace/api-server", "run", "start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cross-tree-paths"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "travel-buddy-standalone: dev"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-checks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "standalone-checks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-test-registration"

[[workflows.workflow]]
name = "api-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[[workflows.workflow]]
name = "cross-tree-paths"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:cross-tree-paths"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "travel-buddy-standalone: dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd travel-buddy-standalone && PORT=3000 pnpm run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "api-checks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run check:all"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "standalone-checks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd travel-buddy-standalone && pnpm run check:all"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "check-test-registration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run check:test-registration"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.shared]
STAMP_WORKER_ENABLED = "true"
EXPO_PUBLIC_SUPABASE_ANON_KEY = "sb_publishable_xp3JiB50mBYHn1S_XjzOAg_rIoEqZKS"
EXPO_PUBLIC_SUPABASE_URL = "https://ajrurzioarfkagpuxfnb.supabase.co"
STAMP_IMAGE_MODEL = "gpt-image-1"
TRANSLATION_PROVIDER = "openai"
SUPABASE_URL = "https://ajrurzioarfkagpuxfnb.supabase.co"
QA_ACCOUNT_EMAIL = "arxaitrading@gmail.com"

[userenv.development]

[userenv.production]
# travel-buddy.io domains retired 2026-08-05 (Portava rebrand) — only the live
# origin remains. The api-server app.ts fallback list is defense-in-depth only.
ALLOWED_ORIGINS = "https://portava.replit.app"

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

