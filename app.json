{
  "expo": {
    "name": "Travel Buddy",
    "slug": "travel-buddy-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelbuddy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6cd481d2-69e8-4311-b352-994c5dcc2ddf"
      }
    }
  }
}
