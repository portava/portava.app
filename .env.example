# Required for the Expo app
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Add other public client integrations only when used
# EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_MAPTILER_KEY=
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ============================================================================
# API server (artifacts/api-server) — env var NAMES the server reads.
# Full grouped list with per-variable comments lives in
# artifacts/api-server/.env.example. NAMES ONLY — never commit values.
# ============================================================================

# Required at boot (server exits if missing — src/lib/envValidation.ts):
# PORT, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET

# Optional — observability:      SENTRY_DSN, LOG_LEVEL
# Optional — internal secrets:   INTERNAL_API_SECRET, CLEANUP_ADMIN_SECRET,
#                                INTERNAL_ADMIN_TOKEN, COMPASS_TOKEN_SECRET, INTERNAL_API_BASE
# Optional — CORS:               ALLOWED_ORIGINS
# Optional — Redis:              REDIS_URL
# Optional — LiveKit calls:      LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
# Optional — maps/places:        FOURSQUARE_API_KEY, GOOGLE_MAPS_API_KEY, MAPBOX_TOKEN,
#                                TICKETMASTER_API_KEY
# Optional — Supabase extras:    SUPABASE_ANON_KEY, SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_TOKEN
# Optional — AI/OpenAI:          AI_INTEGRATIONS_OPENAI_API_KEY, AI_INTEGRATIONS_OPENAI_BASE_URL,
#                                AI_IMAGE_MODEL, AI_IMAGE_QUALITY, AI_IMAGE_COST_ESTIMATE,
#                                AI_VISUAL_WORKER_INTERVAL_MS, AI_VISUAL_DAILY_LIMIT,
#                                AI_VISUAL_USER_DAILY_LIMIT, AI_VISUAL_COST_PER_IMAGE,
#                                AI_VISUAL_BUCKET, AI_VISUAL_FALLBACK_BASE, AI_VISUAL_MAX_RETRIES
# Optional — stamp worker:       STAMP_WORKER_ENABLED, STAMP_IMAGE_MODEL, STAMP_IMAGE_QUALITY,
#                                STAMP_WORKER_INTERVAL_MS, STAMP_MIN_CANDIDATES,
#                                STAMP_FAILED_REQUEUE_HOURS, STAMP_FAILED_REQUEUE_MAX_ROUNDS,
#                                STAMP_STALE_SWEEP_INTERVAL_MINUTES, STAMP_COUNTRY_SWEEP_ENABLED
# Optional — FX refresh:         FX_REFRESH_ENABLED, FX_REFRESH_INTERVAL_MS, FX_REFRESH_URL
# Optional — identity/KYC:       IDENTITY_PROVIDER, ALLOW_REMOTE_VERIFY
# Optional — rate limits:        REPORT_RATE_LIMIT_PER_HOUR, MUTE_RATE_LIMIT_PER_DAY,
#                                MODERATION_REPORT_RATE_LIMIT_PER_DAY, CIRCLE_MEMBERS_RL_LIMIT,
#                                CIRCLE_PRESENCE_RL_LIMIT, CIRCLE_NEED_HELP_RL_LIMIT,
#                                CRASH_REPORT_WINDOW_MS, CRASH_REPORT_MAX_REPORTS
# Optional — sweepers:           EVENT_WAITLIST_SWEEP_INTERVAL_HOURS, EVENT_WAITLIST_SWEEP_STARTUP_DELAY_MS,
#                                INVITE_SLOT_RECONCILE_INTERVAL_HOURS, INVITE_SLOT_RECONCILE_MIN_AGE_MINUTES,
#                                INVITE_SLOT_SWEEP_INTERVAL_HOURS, INVITE_SLOT_SWEEP_TTL_HOURS,
#                                ZOMBIE_TOKEN_SWEEP_INTERVAL_HOURS, ZOMBIE_TOKEN_SWEEP_LOOKBACK_DAYS,
#                                ZOMBIE_TOKEN_SWEEP_FAILURE_THRESHOLD, DAILY_BRIEF_RETENTION_DAYS,
#                                DAILY_BRIEF_CLEANUP_INTERVAL_HOURS, DELAYED_POST_PUBLISH_INTERVAL_MINUTES,
#                                WEATHER_CACHE_RETENTION_HOURS, SUGGESTION_SEEN_TTL_HOURS,
#                                SUGGESTION_SEEN_MAX, PLACE_COLLECTIONS_WORKER_ENABLED,
#                                GEOFENCE_CONFIRMATION_MINUTES, OFF_APP_SUSPENSION_THRESHOLD
# Optional — translation:        TRANSLATION_ENABLED, TRANSLATION_PROVIDER, TRANSLATION_TIMEOUT_MS
# Optional — misc:               NODE_ENV, APP_ENV, API_BASE_URL, API_BASE, APP_RETURN_BASE_URL,
#                                GENERIC_COVER_URL, PORTAVA_ACCOUNT_UUID, PORTAVA_ACCOUNT_EMAIL,
#                                ALLOW_TEST_MEDIA_SEED, SEED_DRY_RUN, SEED_EMAIL,
#                                REPLIT_DEV_DOMAIN, HOSTNAME, FONTCONFIG_PATH
